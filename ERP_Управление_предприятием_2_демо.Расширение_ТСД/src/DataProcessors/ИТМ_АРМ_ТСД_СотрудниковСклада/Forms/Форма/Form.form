  <attributes>
    <name>СписокЗаказовНаПрроизводство</name>
    <title>
      <key>ru</key>
      <value>Список заказов на прроизводство</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокЗаказовНаПрроизводство.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК Номенклатура,
	ЗаказНаПроизводство2_2Продукция.Характеристика КАК Характеристика,
	СУММА(ЗаказНаПроизводство2_2Продукция.Количество) КАК Количество,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Ссылка КАК Ссылка,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Номер КАК Номер,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Дата КАК Дата,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Подразделение КАК Подразделение,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Организация КАК Организация,
	ВЫРАЗИТЬ(ЗаказНаПроизводство2_2Продукция.Ссылка.Комментарий КАК СТРОКА(100)) КАК Комментарий,
	ЗаказНаПроизводство2_2Продукция.Ссылка.НачатьНеРанее КАК НачатьНеРанее,
	ЗаказНаПроизводство2_2Продукция.Ссылка.ДатаПотребности КАК ДатаПотребности
ПОМЕСТИТЬ ВременнаяТаблица
ИЗ
	Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
ГДЕ
	ЗаказНаПроизводство2_2Продукция.Ссылка.Проведен
	И ЗаказНаПроизводство2_2Продукция.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство2_2.КПроизводству)

СГРУППИРОВАТЬ ПО
	ЗаказНаПроизводство2_2Продукция.Номенклатура,
	ЗаказНаПроизводство2_2Продукция.Характеристика,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Ссылка,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Номер,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Дата,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Подразделение,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Организация,
	ЗаказНаПроизводство2_2Продукция.Ссылка.НачатьНеРанее,
	ЗаказНаПроизводство2_2Продукция.Ссылка.ДатаПотребности,
	ВЫРАЗИТЬ(ЗаказНаПроизводство2_2Продукция.Ссылка.Комментарий КАК СТРОКА(100))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Характеристика,
	СУММА(-ВыпускПродукцииОбороты.КоличествоОборот),
	ЗаказНаПроизводство2_2.Ссылка,
	ЗаказНаПроизводство2_2.Номер,
	ЗаказНаПроизводство2_2.Дата,
	ЗаказНаПроизводство2_2.Подразделение,
	ЗаказНаПроизводство2_2.Организация,
	ВЫРАЗИТЬ(ЗаказНаПроизводство2_2.Комментарий КАК СТРОКА(100)),
	ЗаказНаПроизводство2_2.НачатьНеРанее,
	ЗаказНаПроизводство2_2.ДатаПотребности
ИЗ
	РегистрНакопления.ВыпускПродукции.Обороты(
			,
			,
			,
			Распоряжение ССЫЛКА Документ.ЭтапПроизводства2_2
				И ВЫРАЗИТЬ(Распоряжение КАК Документ.ЭтапПроизводства2_2).Распоряжение.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство2_2.КПроизводству)) КАК ВыпускПродукцииОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
		ПО ВыпускПродукцииОбороты.Распоряжение.Распоряжение = ЗаказНаПроизводство2_2.Ссылка

СГРУППИРОВАТЬ ПО
	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Характеристика,
	ЗаказНаПроизводство2_2.Ссылка,
	ЗаказНаПроизводство2_2.Номер,
	ЗаказНаПроизводство2_2.Дата,
	ЗаказНаПроизводство2_2.Подразделение,
	ЗаказНаПроизводство2_2.Организация,
	ВЫРАЗИТЬ(ЗаказНаПроизводство2_2.Комментарий КАК СТРОКА(100)),
	ЗаказНаПроизводство2_2.НачатьНеРанее,
	ЗаказНаПроизводство2_2.ДатаПотребности
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВременнаяТаблица.Номенклатура КАК Номенклатура,
	ВременнаяТаблица.Характеристика КАК Характеристика,
	СУММА(ВременнаяТаблица.Количество) КАК Количество,
	ВременнаяТаблица.Ссылка КАК Ссылка,
	ВременнаяТаблица.Номер КАК Номер,
	ВременнаяТаблица.Дата КАК Дата,
	ВременнаяТаблица.Подразделение КАК Подразделение,
	ВременнаяТаблица.Организация КАК Организация,
	ВременнаяТаблица.Комментарий КАК Комментарий,
	ВременнаяТаблица.НачатьНеРанее КАК НачатьНеРанее,
	ВременнаяТаблица.ДатаПотребности КАК ДатаПотребности
ИЗ
	ВременнаяТаблица КАК ВременнаяТаблица

СГРУППИРОВАТЬ ПО
	ВременнаяТаблица.Номенклатура,
	ВременнаяТаблица.Характеристика,
	ВременнаяТаблица.Ссылка,
	ВременнаяТаблица.Номер,
	ВременнаяТаблица.Дата,
	ВременнаяТаблица.Подразделение,
	ВременнаяТаблица.Организация,
	ВременнаяТаблица.НачатьНеРанее,
	ВременнаяТаблица.ДатаПотребности,
	ВременнаяТаблица.Комментарий

ИМЕЮЩИЕ
	СУММА(ВременнаяТаблица.Количество) > 0</queryText>
