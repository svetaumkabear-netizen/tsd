
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.Назад.Видимость = Ложь; 
	ТекущаяСтраница = 0;  
	Параметры.Свойство("СкладОприходования", Склад);
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.ГруппаДанные.Видимость = Ложь;
	Элементы.ГруппаОшибка.Видимость = Ложь;
	ПодключитьОбработчикОжидания("ПроверитьНаличиеНовогоВыпуска", 1, Истина);

	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтаФорма);

	#Если МобильныйКлиент Тогда
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияУТКлиент.ЕстьНеобработанноеСобытие() Тогда
			
			Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСканированиеШК Тогда
			
			
				ОбработатьШтрихкоды(МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр).Штрихкод);
			Иначе 
				ОбработатьШтрихкодыПаллетыНаСервере(МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр).Штрихкод);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//++Локализация
	ОбщегоНазначенияСобытияФормИСКлиентПереопределяемый.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	//--Локализация
	
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	ТекущаяСтраница = ТекущаяСтраница - 1;
	Элементы.Страницы.ТекущаяСтраница = Элементы.Страницы.ПодчиненныеЭлементы[ТекущаяСтраница];
	Элементы.Назад.Видимость = ТекущаяСтраница > 0;
	Элементы.ГруппаСоставКоробки.Видимость = Истина;  
КонецПроцедуры

&НаКлиенте
Процедура СканироватьШК(Команда)
	
	ОчиститьСообщения();
	#Если МобильныйКлиент Тогда
	Если СредстваМультимедиа.ПоддерживаетсяСканированиеШтрихКодов() Тогда
		
		ОбработчикСканирования = Новый ОписаниеОповещения("ОбработкаСканирования", ЭтаФорма);
		
		СредстваМультимедиа.ПоказатьСканированиеШтрихКодов(НСтр("ru = 'Наведите камеру на штрихкод';
																|en = 'Point the camera at the barcode'"),
			ОбработчикСканирования);
	Иначе
		Оповещение = Новый ОписаниеОповещения("СканироватьШКЗавершение", ЭтотОбъект);
		ШтрихкодированиеНоменклатурыКлиент.ПоказатьВводШтрихкода(Оповещение);
	КонецЕсли;
	#Иначе
		Оповещение = Новый ОписаниеОповещения("СканироватьШКЗавершение", ЭтотОбъект);
		ШтрихкодированиеНоменклатурыКлиент.ПоказатьВводШтрихкода(Оповещение);
	#КонецЕсли


	Элементы.ГруппаДанные.Видимость = Ложь;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаСканирования(ШК, Результат, Сообщение, ДополнительныеПараметры) Экспорт

	#Если МобильныйКлиент Тогда
	Если Результат Тогда
		
		СредстваМультимедиа.ВоспроизвестиЗвуковоеОповещение(ЗвуковоеОповещение.ПоУмолчанию,Истина);
		СредстваМультимедиа.ЗакрытьСканированиеШтрихКодов();
		
		ОбработатьШтрихкоды(ШК);
	Иначе	
		Сообщение = НСтр("ru = 'Ошибка обработки штрих кода';
						|en = 'Barcode processing error'");
	КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры


&НаКлиенте
Процедура СканироватьШКЗавершение(ДанныеШтрихкода, ДополнительныеПараметры) Экспорт
	
	ОбработатьШтрихкоды(ДанныеШтрихкода.Штрихкод);
	
КонецПроцедуры  

&НаКлиенте
Процедура СканироватьШКПаллеты(Команда)
	ОчиститьСообщения();
	#Если МобильныйКлиент Тогда
	Если СредстваМультимедиа.ПоддерживаетсяСканированиеШтрихКодов() Тогда
		
		ОбработчикСканирования = Новый ОписаниеОповещения("ОбработкаСканированияШКПалеты", ЭтаФорма);
		
		СредстваМультимедиа.ПоказатьСканированиеШтрихКодов(НСтр("ru = 'Наведите камеру на штрихкод';
																|en = 'Point the camera at the barcode'"),
			ОбработчикСканирования);
	Иначе
		Оповещение = Новый ОписаниеОповещения("СканироватьШКПаллетыЗавершение", ЭтотОбъект);
		ШтрихкодированиеНоменклатурыКлиент.ПоказатьВводШтрихкода(Оповещение);
	КонецЕсли;
	#Иначе
		Оповещение = Новый ОписаниеОповещения("СканироватьШКПаллетыЗавершение", ЭтотОбъект);
		ШтрихкодированиеНоменклатурыКлиент.ПоказатьВводШтрихкода(Оповещение);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСканированияШКПалеты(ШК, Результат, Сообщение, ДополнительныеПараметры) Экспорт

	#Если МобильныйКлиент Тогда
	Если Результат Тогда
		
		СредстваМультимедиа.ВоспроизвестиЗвуковоеОповещение(ЗвуковоеОповещение.ПоУмолчанию,Истина);
		СредстваМультимедиа.ЗакрытьСканированиеШтрихКодов();
		
		ОбработатьШтрихкодыПаллетыНаСервере(ШК);
	Иначе	
		Сообщение = НСтр("ru = 'Ошибка обработки штрих кода';
						|en = 'Barcode processing error'");
	КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры



&НаКлиенте
Процедура ОбработатьШтрихкоды(Штрихкод)
	
	Если Не ШтрихкодированиеНоменклатурыКлиент.ШтрихкодыВалидны(Новый Структура ("Штрихкод", Штрихкод)) Тогда
		Возврат;
	КонецЕсли;
	ОбработатьШтрихкодыНаСервере(Штрихкод);
КонецПроцедуры  


&НаКлиенте
Процедура СканироватьШКПаллетыЗавершение(ДанныеШтрихкода, ДополнительныеПараметры) Экспорт
	
	ОбработатьШтрихкодыПаллетыНаСервере(ДанныеШтрихкода.Штрихкод);
	
КонецПроцедуры  



&НаСервере
Процедура ОбработатьШтрихкодыНаСервере(Штрихкод)
	Запрос =  Новый Запрос;
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка);
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСканированияШКПалета;
		Элементы.Назад.Видимость = Истина;
		ТекущаяСтраница = 1;
		Элементы.ДекорацияОписание.Заголовок = 
		"Заказ на производство:
		|Номенклатура: " + Строка(Номенклатура) + "
		|Харакетристика: " + Строка(Характеристика) + "
		|Упаковка: " + Строка(Упаковка);
		
		Элементы.ГруппаДанные.Видимость = Ложь;
		Элементы.ГруппаОшибка.Видимость = Ложь;
		Элементы.СканироватьШКПаллеты.Видимость = Истина; 
		
		//Элементы.СканироватьШК.Видимость = Ложь;
	Иначе
		Элементы.ГруппаДанные.Видимость = Ложь;
		Элементы.ГруппаОшибка.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ОбработатьШтрихкодыПаллетыНаСервере(ПереданныйШтрихкод)
	
	ШтрихКодПаллетры =  ПереданныйШтрихкод;
	
	Запрос =  Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКодПалеты", ПереданныйШтрихкод);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки.ШтрихКодПалеты КАК ШтрихКодПалеты,
	|	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки.КоличествоОстаток КАК Количество,
	|	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки.КоличествоУпаковокОстаток КАК КоличествоУпаковок,
	|	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки.Номенклатура КАК Номенклатура,
	|	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки.Характеристика КАК Характеристика,
	|	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрНакопления.ИТМ_ДанныеВыпускаПродукцииИПередачиНаСклад.Остатки(, ШтрихКодПалеты = &ШтрихКодПалеты) КАК ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка);
		
		Элементы.ДекорацияОписание1.Заголовок = 
		"Заказ на производство: " + Строка(ЗаказНаПроизводство) + "
		|Номенклатура: " + Строка(Номенклатура) + "
		|Харакетристика: " + Строка(Характеристика) + "
		|Упаковка: " + Строка(Упаковка) + "
		|Количество: " + Строка(Количество) + "
		|Количество упаковок: " + Строка(КоличествоУпаковок);

		Элементы.ГруппаДанные.Видимость = Истина;  
		Элементы.ГруппаСоставКоробки.Видимость = Ложь;
		Элементы.СканироватьШК.Видимость = Истина;
		
		Элементы.ГруппаОшибка.Видимость = Ложь;
	Иначе
		Элементы.ГруппаДанные.Видимость = Ложь;
		Элементы.ГруппаОшибка.Видимость = Истина; 		
		//Элементы.СканироватьШКПаллеты.Видимость = Ложь;
		Элементы.СканироватьШК.Видимость = Истина; 
		Элементы.Назад.Видимость = Ложь;
		ТекущаяСтраница = 0;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСканированиеШК;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПередачаНаСкладНаСервере()
	НовыйДокумент = Документы.ИТМ_ОприходованиеПродукцииОператором.СоздатьДокумент();
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ЗаказНаПроизводство", ЗаказНаПроизводство);
	ДанныеЗаполнения.Вставить("Номенклатура", Номенклатура);
	ДанныеЗаполнения.Вставить("Характеристика", Характеристика);
	ДанныеЗаполнения.Вставить("Количество", КоличествоУпаковок);
	ДанныеЗаполнения.Вставить("Автор", Пользователи.АвторизованныйПользователь());
	ДанныеЗаполнения.Вставить("Упаковка", Упаковка);
	ДанныеЗаполнения.Вставить("ШтрихКодПалеты", ШтрихКодПаллетры);
	НовыйДокумент.Заполнить(ДанныеЗаполнения);
	НовыйДокумент.Дата = ТекущаяДата();
	НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередачаНаСклад(Команда)
	ПередачаНаСкладНаСервере();
	Элементы.ГруппаДанные.Видимость = Ложь; 
	Элементы.ГруппаСоставКоробки.Видимость = Истина;  
	Назад("");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеНовогоВыпуска() Экспорт
	
	КоличествоПаллетКОприходованию =  ПроверитьНаличиеНовогоВыпускаНаСервере();
	Элементы.ДекорацияСообщения.Видимость = КоличествоПаллетКОприходованию > 0;
	Элементы.ДекорацияСообщения.Заголовок = "Количество палет к оприходованию: " + Формат(КоличествоПаллетКОприходованию, "ЧГ=3,0");
	ПодключитьОбработчикОжидания("ПроверитьНаличиеНовогоВыпуска", 10, Истина);
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПроверитьНаличиеНовогоВыпускаНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки.ШтрихКодПалеты) КАК ШтрихКодПалеты
	|ИЗ
	|	РегистрНакопления.ИТМ_ДанныеВыпускаПродукцииИПередачиНаСклад.Остатки КАК ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОстатки";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат 0;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.ШтрихКодПалеты;
	КонецЕсли;
	
КонецФункции


