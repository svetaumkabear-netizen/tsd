
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.Назад.Видимость = Ложь; 
	ТекущаяСтраница = 0;  
	Параметры.Свойство("ЗаказНаПроизводство", ЗаказНаПроизводство); 
	Параметры.Свойство("Номенклатура", Номенклатура); 
	Параметры.Свойство("Характеристика", Характеристика); 
	
	Параметры.Свойство("Организация", Организация); 
	Если Параметры.Свойство("ВидНоменклатуры") Тогда 
		Массив = Новый Массив;
		Для каждого строкаПараметр Из Параметры.ВидНоменклатуры Цикл
			
			Массив.Добавить(строкаПараметр);
		КонецЦикла;
	
		ВидНоменклатуры.ЗагрузитьЗначения(Массив);
	КонецЕсли;
	
	СписокЗаказовНаПрроизводство.Параметры.УстановитьЗначениеПараметра("ОтборПоОрганизации", Ложь);
	СписокЗаказовНаПрроизводство.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	СписокЗаказовНаПрроизводство.Параметры.УстановитьЗначениеПараметра("ОтборПоВидуНоменклатуры", Ложь);
	СписокЗаказовНаПрроизводство.Параметры.УстановитьЗначениеПараметра("ВидНоменклатуры", ВидНоменклатуры.ВыгрузитьЗначения());
	
	ЕдИзмПаллета = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("Паллет");
	
КонецПроцедуры

