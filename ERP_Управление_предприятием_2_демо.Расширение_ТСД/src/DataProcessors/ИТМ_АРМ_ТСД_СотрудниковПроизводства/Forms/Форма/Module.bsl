&НаКлиенте
Процедура Назад(Команда)
	
	ТекущаяСтраница = ТекущаяСтраница - 1;
	Элементы.Страницы.ТекущаяСтраница = Элементы.Страницы.ПодчиненныеЭлементы[ТекущаяСтраница];
	Элементы.Назад.Видимость = ТекущаяСтраница > 0;
	
КонецПроцедуры 


&НаКлиенте
Процедура СписокЗаказовНаПрроизводствоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекДанные =  Элементы.СписокЗаказовНаПрроизводство.ТекущиеДанные;

	
	ЗаказНаПроизводство = ТекДанные.Ссылка; 
	
	Номенклатура = ТекДанные.Номенклатура;
	Характеристика = ТекДанные.Характеристика;
	
	стрКоличество = ТекДанные.Количество;
	
	КоличествоПлан =  ТекДанные.КоличествоПлан;
	
	Элементы.Количество.ПодсказкаВвода = стрКоличество;
	//КарточкаАнализа =  ТекДанные.КарточкаАнализа;
	КоличествоВыпущено = КоличествоПлан - стрКоличество;
	ЗаполнитьУпаковку();
	
	Элементы.ДекорацияКоличество.Заголовок = СтрШаблон("По плану: %1 / выпущено: %2", Формат(КоличествоПлан, "ЧДЦ=3; ЧГ=3,0"), Формат(КоличествоВыпущено, "ЧДЦ=3; ЧН=0; ЧГ=3,0"));
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаВыпускПродукции;
	ТекущаяСтраница = 1;
	Элементы.Назад.Видимость = ТекущаяСтраница > 0;
	Элементы.ГруппаСтраницыВыпуска.ТекущаяСтраница = Элементы.ГруппаСтраницаОформитьВыпуск;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНоменклатурыЗаказаНаПроизводствоВыборЗавершение(Результат, ДопРеквизиты) Экспорт
	
	Элементы.ДекорацияКоличество.Заголовок = СтрШаблон("По плану: %1 / выпущено: %2", Формат(КоличествоПлан, "ЧДЦ=3; ЧГ=3,0"), Формат(КоличествоВыпущено + Количество, "ЧДЦ=3; ЧН=0; ЧГ=3,0"));
	
	Если  КоличествоПлан <= КоличествоВыпущено + Количество Тогда 
		Назад("");
	КонецЕсли;
		
	Количество = 0;

КонецПроцедуры

&НаКлиенте
Процедура ОтразитьВыпуск(Команда)
	
	Если Количество = 0 Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнено количество",,"Количество");
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ЗаказНаПроизводство", ЗаказНаПроизводство);
	ДанныеЗаполнения.Вставить("Номенклатура", Номенклатура);
	ДанныеЗаполнения.Вставить("Характеристика", Характеристика);
	ДанныеЗаполнения.Вставить("Количество", Количество);
	ДанныеЗаполнения.Вставить("Автор", ПользователиКлиент.АвторизованныйПользователь());
	ДанныеЗаполнения.Вставить("КоличествоПлан", КоличествоПлан);
	ДанныеЗаполнения.Вставить("КоличествоВыпущено", КоличествоПлан - Количество);
	ДанныеЗаполнения.Вставить("ЭтоОткрытиеИзРМОператора", Истина);
	ДанныеЗаполнения.Вставить("КарточкаАнализа", КарточкаАнализа);
	ДанныеЗаполнения.Вставить("Упаковка", Упаковка);
	ДанныеЗаполнения.Вставить("ШтрихкодНоменклатуры", ШтрихкодНоменклатуры);
	
	#Если Не МобильныйКлиент Тогда
	ОткрытьФорму("Документ.ИТМ_ВыпускПродукцииОператором.Форма.ФормаДокумента", Новый Структура("Основание", ДанныеЗаполнения), Элементы.ГруппаСтраницаОформитьВыпуск,
		,Окно, ,Новый ОписаниеОповещения("ТаблицаНоменклатурыЗаказаНаПроизводствоВыборЗавершение",ЭтотОбъект));//,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); 
	#Иначе
	ОткрытьФорму("Документ.ИТМ_ВыпускПродукцииОператором.Форма.ФормаДокумента", Новый Структура("Основание", ДанныеЗаполнения), Элементы.ГруппаСтраницаОформитьВыпуск,
		,, ,Новый ОписаниеОповещения("ТаблицаНоменклатурыЗаказаНаПроизводствоВыборЗавершение",ЭтотОбъект));//,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); 
	#КонецЕсли
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУпаковку()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗШтрихкоды.Номенклатура КАК Номенклатура,
		|	ТЗШтрихкоды.Характеристика КАК Характеристика,
		|	ТЗШтрихкоды.Упаковка КАК Упаковка,
		|	ТЗШтрихкоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК ТЗШтрихкоды
		|ГДЕ
		|	ТЗШтрихкоды.Номенклатура = &Номенклатура
		|	И ТЗШтрихкоды.Характеристика = &Характеристика
		|";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Паллета", ЕдИзмПаллета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Упаковка = Выборка.Упаковка;
		ШтрихкодНоменклатуры = Выборка.Штрихкод;
	КонецЦикла;
	
КонецПроцедуры


