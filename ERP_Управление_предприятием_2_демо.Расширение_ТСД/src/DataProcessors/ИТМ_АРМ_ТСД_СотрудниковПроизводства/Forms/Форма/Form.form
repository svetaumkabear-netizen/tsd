  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <scalingMode>Normal</scalingMode>
  <scale>150.0</scale>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Объект</name>
    <id>1</id>
    <valueType>
      <types>DataProcessorObject.ИТМ_АРМ_ТСД_СотрудниковПроизводства</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
  </attributes>
  <attributes>
    <name>СписокЗаказовНаПрроизводство</name>
    <title>
      <key>ru</key>
      <value>Список заказов на прроизводство</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокЗаказовНаПрроизводство.КарточкаАнализа</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокЗаказовНаПрроизводство.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК Номенклатура,
	ЗаказНаПроизводство2_2Продукция.Характеристика КАК Характеристика,
	СУММА(ЗаказНаПроизводство2_2Продукция.Количество) КАК Количество,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Ссылка КАК Ссылка,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Номер КАК Номер,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Дата КАК Дата,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Подразделение КАК Подразделение,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Организация КАК Организация,
	ВЫРАЗИТЬ(ЗаказНаПроизводство2_2Продукция.Ссылка.Комментарий КАК СТРОКА(100)) КАК Комментарий,
	ЗаказНаПроизводство2_2Продукция.Ссылка.НачатьНеРанее КАК НачатьНеРанее,
	ЗаказНаПроизводство2_2Продукция.Ссылка.ДатаПотребности КАК ДатаПотребности,
	СУММА(ЗаказНаПроизводство2_2Продукция.Количество) КАК КоличествоПлан,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Статус КАК Статус
ПОМЕСТИТЬ ВременнаяТаблица
ИЗ
	Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
ГДЕ
	ЗаказНаПроизводство2_2Продукция.Ссылка.Проведен
	И ЗаказНаПроизводство2_2Продукция.Ссылка.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство2_2.КПроизводству), ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство2_2.Закрыт))
	И ВЫБОР
			КОГДА &amp;ОтборПоОрганизации
				ТОГДА ЗаказНаПроизводство2_2Продукция.Ссылка.Организация = &amp;Организация
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ОтборПоВидуНоменклатуры
				ТОГДА ЗаказНаПроизводство2_2Продукция.Номенклатура.ВидНоменклатуры В (&amp;ВидНоменклатуры)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	ЗаказНаПроизводство2_2Продукция.Номенклатура,
	ЗаказНаПроизводство2_2Продукция.Характеристика,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Ссылка,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Номер,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Дата,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Подразделение,
	ЗаказНаПроизводство2_2Продукция.Ссылка.Организация,
	ЗаказНаПроизводство2_2Продукция.Ссылка.НачатьНеРанее,
	ЗаказНаПроизводство2_2Продукция.Ссылка.ДатаПотребности,
	ВЫРАЗИТЬ(ЗаказНаПроизводство2_2Продукция.Ссылка.Комментарий КАК СТРОКА(100)),
	ЗаказНаПроизводство2_2Продукция.Ссылка.Статус

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Характеристика,
	СУММА(-ВыпускПродукцииОбороты.КоличествоОборот),
	ЗаказНаПроизводство2_2.Ссылка,
	ЗаказНаПроизводство2_2.Номер,
	ЗаказНаПроизводство2_2.Дата,
	ЗаказНаПроизводство2_2.Подразделение,
	ЗаказНаПроизводство2_2.Организация,
	ВЫРАЗИТЬ(ЗаказНаПроизводство2_2.Комментарий КАК СТРОКА(100)),
	ЗаказНаПроизводство2_2.НачатьНеРанее,
	ЗаказНаПроизводство2_2.ДатаПотребности,
	0,
	ЗаказНаПроизводство2_2.Статус
ИЗ
	РегистрНакопления.ВыпускПродукции.Обороты(
			,
			,
			,
			Распоряжение ССЫЛКА Документ.ЭтапПроизводства2_2
				И ВЫРАЗИТЬ(Распоряжение КАК Документ.ЭтапПроизводства2_2).Распоряжение.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство2_2.КПроизводству), ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство2_2.Закрыт))) КАК ВыпускПродукцииОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
		ПО ВыпускПродукцииОбороты.Распоряжение.Распоряжение = ЗаказНаПроизводство2_2.Ссылка

СГРУППИРОВАТЬ ПО
	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Характеристика,
	ЗаказНаПроизводство2_2.Ссылка,
	ЗаказНаПроизводство2_2.Номер,
	ЗаказНаПроизводство2_2.Дата,
	ЗаказНаПроизводство2_2.Подразделение,
	ЗаказНаПроизводство2_2.Организация,
	ВЫРАЗИТЬ(ЗаказНаПроизводство2_2.Комментарий КАК СТРОКА(100)),
	ЗаказНаПроизводство2_2.НачатьНеРанее,
	ЗаказНаПроизводство2_2.ДатаПотребности,
	ЗаказНаПроизводство2_2.Статус
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВременнаяТаблица.Номенклатура КАК Номенклатура,
	ВременнаяТаблица.Характеристика КАК Характеристика,
	СУММА(ВременнаяТаблица.Количество) КАК Количество,
	ВременнаяТаблица.Ссылка КАК Ссылка,
	ВременнаяТаблица.Номер КАК Номер,
	ВременнаяТаблица.Дата КАК Дата,
	ВременнаяТаблица.Подразделение КАК Подразделение,
	ВременнаяТаблица.Организация КАК Организация,
	ВременнаяТаблица.Комментарий КАК Комментарий,
	ВременнаяТаблица.НачатьНеРанее КАК НачатьНеРанее,
	ВременнаяТаблица.ДатаПотребности КАК ДатаПотребности,
	ВременнаяТаблица.КоличествоПлан КАК КоличествоПлан,
	ВременнаяТаблица.Статус КАК Статус
ПОМЕСТИТЬ ВременнаяТаблица1
ИЗ
	ВременнаяТаблица КАК ВременнаяТаблица

СГРУППИРОВАТЬ ПО
	ВременнаяТаблица.Номенклатура,
	ВременнаяТаблица.Характеристика,
	ВременнаяТаблица.Ссылка,
	ВременнаяТаблица.Номер,
	ВременнаяТаблица.Дата,
	ВременнаяТаблица.Подразделение,
	ВременнаяТаблица.Организация,
	ВременнаяТаблица.НачатьНеРанее,
	ВременнаяТаблица.ДатаПотребности,
	ВременнаяТаблица.Комментарий,
	ВременнаяТаблица.КоличествоПлан,
	ВременнаяТаблица.Статус

ИМЕЮЩИЕ
	СУММА(ВременнаяТаблица.Количество) > 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОбороты.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОбороты.Номенклатура КАК Номенклатура,
	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОбороты.Характеристика КАК Характеристика,
	СУММА(ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОбороты.КоличествоПриход) КАК КоличествоПриход
ПОМЕСТИТЬ втВыпуски
ИЗ
	РегистрНакопления.ИТМ_ДанныеВыпускаПродукцииИПередачиНаСклад.Обороты(
			,
			,
			,
			(ЗаказНаПроизводство, Номенклатура, Характеристика) В
				(ВЫБРАТЬ
					ВременнаяТаблица1.Ссылка КАК Ссылка,
					ВременнаяТаблица1.Номенклатура КАК Номенклатура,
					ВременнаяТаблица1.Характеристика КАК Характеристика
				ИЗ
					ВременнаяТаблица1 КАК ВременнаяТаблица1)) КАК ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОбороты

СГРУППИРОВАТЬ ПО
	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОбороты.ЗаказНаПроизводство,
	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОбороты.Номенклатура,
	ИТМ_ДанныеВыпускаПродукцииИПередачиНаСкладОбороты.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВременнаяТаблица1.Номенклатура КАК Номенклатура,
	ВременнаяТаблица1.Характеристика КАК Характеристика,
	ВременнаяТаблица1.Количество - ЕСТЬNULL(втВыпуски.КоличествоПриход, 0) КАК Количество,
	ВременнаяТаблица1.Ссылка КАК Ссылка,
	ВременнаяТаблица1.Номер КАК Номер,
	ВременнаяТаблица1.Комментарий КАК Комментарий,
	ВременнаяТаблица1.ДатаПотребности КАК ДатаПотребности,
	ВременнаяТаблица1.КоличествоПлан КАК КоличествоПлан,
	ИСТИНА КАК ЕстьКарточкаАнализа,
	&quot;&quot;&quot;&quot; КАК КарточкаАнализа,
	ВременнаяТаблица1.Статус КАК Статус
ИЗ
	ВременнаяТаблица1 КАК ВременнаяТаблица1
		ЛЕВОЕ СОЕДИНЕНИЕ втВыпуски КАК втВыпуски
		ПО (втВыпуски.ЗаказНаПроизводство = ВременнаяТаблица1.Ссылка)
			И (втВыпуски.Номенклатура = ВременнаяТаблица1.Номенклатура)
			И (втВыпуски.Характеристика = ВременнаяТаблица1.Характеристика)
ГДЕ
	ВременнаяТаблица1.Количество - ЕСТЬNULL(втВыпуски.КоличествоПриход, 0) > 0</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
