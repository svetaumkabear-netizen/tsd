
&Вместо("НастройкиФормы")
Функция ИТМ_НастройкиФормы(Форма)
	// Вставить содержимое метода.
	Результат = ПродолжитьВызов(Форма);
    Если Форма = ПредопределенноеЗначение("Перечисление.ФормыОткрываемыеПриНачалеРаботыСистемы.ИТМ_АРМ_ТСД_СотрудниковПроизводства") Тогда

        Результат.Вставить("ИмяЗапускаемойФормы", "Обработка.ИТМ_АРМ_ТСД_СотрудниковПроизводства.Форма.Форма");
		Результат.Вставить("Роль",                "ПолныеПрава");
        Результат.Вставить("ПараметрЗапуска",     "ITM_TSD_Production");

        Результат.Вставить("НеобходимыНастройки", Ложь);
        Результат.Вставить("ИмяФормыНастроек",    "Обработка.ИТМ_АРМ_ТСД_СотрудниковПроизводства.Форма.НастройкаПараметровРабочегоМеста");
    КонецЕсли;
	Если Форма = ПредопределенноеЗначение("Перечисление.ФормыОткрываемыеПриНачалеРаботыСистемы.ИТМ_АРМ_ТСД_СотрудниковСклада") Тогда

	    Результат.Вставить("ИмяЗапускаемойФормы", "Обработка.ИТМ_АРМ_ТСД_СотрудниковСклада.Форма.Форма");
	    Результат.Вставить("Роль",                "ИТМ_ОператорСкладаТСД");
	    Результат.Вставить("ПараметрЗапуска",     "ITM_TSD_Warehouse");
	    Результат.Вставить("НеобходимыНастройки", ложь);
	    Результат.Вставить("ИмяФормыНастроек",    "Обработка.ИТМ_АРМ_ТСД_СотрудниковСклада.Форма.НастройкаПараметровРабочегоМеста");
	КонецЕсли;
	Возврат Результат;
КонецФункции
