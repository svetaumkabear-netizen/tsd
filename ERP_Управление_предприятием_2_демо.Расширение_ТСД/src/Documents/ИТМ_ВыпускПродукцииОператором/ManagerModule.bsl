Процедура ПечатьМЯ(МассивОбъектов, КоллекцияПечатныхФорм) Экспорт
    УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
            КоллекцияПечатныхФорм,
            "ПФ_MXL_МаркировочныйЯрлык_ГП",
            НСтр("ru = 'Маркировочный ярлык/ внешний (ГП)'"),
            СформироватьПечатнуюФорму(МассивОбъектов));
КонецПроцедуры

Функция СформироватьПечатнуюФорму(МассивОбъектов)
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	
	ТипСсылки = МассивОбъектов[0].Метаданные().Имя;
	
	СформироватьМаркировочныеЯрлыкиГП(ТабДокумент, МассивОбъектов, ТипСсылки);
	
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.РазмерСтраницы = "A4";
	ТабДокумент.ПолеСлева   = 10;
	ТабДокумент.ПолеСправа  = 10;
	ТабДокумент.ПолеСверху  = 10;
	ТабДокумент.ПолеСнизу   = 10;
	ТабДокумент.КлючПараметровПечати = "ТСД_МаркировочныйЯрлык";
	ТабДокумент.ИмяПараметровПечати = "ТСД_МаркировочныйЯрлык";
	
	Возврат ТабДокумент;
КонецФункции

Процедура СформироватьМаркировочныеЯрлыкиГП(ТабДокумент, МассивОбъектов, ТипСсылки) Экспорт

	
	МакетГП     = ПолучитьМакет("МаркировочныйЯрлыкГП_2023");
	
	ОбластьГП     = МакетГП.ПолучитьОбласть("Шапка");
	
	ЧислоКопий = 1;
	
	
	ТабДокумент.Вывести(ОбластьГП);
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
КонецПроцедуры	
	
