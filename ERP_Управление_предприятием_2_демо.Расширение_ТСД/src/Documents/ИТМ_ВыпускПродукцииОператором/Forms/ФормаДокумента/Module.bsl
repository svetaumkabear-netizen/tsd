&НаСервере
Процедура ЗаполнитьИЗапистьНовыйДокументНаСервере()
	
	//Номер = Объект.Номер;
	Объект.Дата = ДобавитьМесяц(ТекущаяДата(), 12);
	Объект.Номер = "";
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	
	НовыйДокумент = Документы.ИТМ_ВыпускПродукцииОператором.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйДокумент, Объект.Ссылка, ,"Номер, Дата");
	НовыйДокумент.Дата = ТекущаяДата();
	НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	//НовыйДокумент.Номер = Номер;
	
	ДанныеОбУпаковке = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентВесОбъемПрочиеРеквизитыУпаковки(Объект.Упаковка, Объект.Номенклатура, , Ложь);
	Количество = Объект.Количество * ДанныеОбУпаковке.Коэффициент;
	
	КоличествоВыпущено = КоличествоВыпущено + Количество;
	Объект.Количество = 0;
	Объект.НомерПаллеты = 0;
	Объект.Номер = "";
	Объект.Дата = ТекущаяДата();
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
	
КонецПроцедуры

