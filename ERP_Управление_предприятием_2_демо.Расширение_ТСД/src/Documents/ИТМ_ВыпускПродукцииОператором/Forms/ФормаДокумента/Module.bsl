#Область СобытияФормы

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Если Параметры.Свойство("Основание")И ТипЗнч(Параметры.Основание) = Тип("Структура") Тогда 
		Параметры.Основание.Свойство("КоличествоПлан", КоличествоПлан);
		Параметры.Основание.Свойство("КоличествоВыпущено", КоличествоВыпущено);
		Параметры.Основание.Свойство("ЭтоОткрытиеИзРМОператора", ЭтоОткрытиеИзРМОператора);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ПриЧтенииСозданииНаСервере();
		//ЗаполнитьУпаковку();
		
	Иначе
		ВыводитьЗаголовки = Пользователи.РолиДоступны("ИТМ_РедактирвоаниеДокументовТСД");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	//#Если МобильныйКлиент Тогда
	ЭтаФорма.КоманднаяПанель.Видимость = Ложь;
	//#КонецЕсли  
	
	Элементы.ГруппаСтраницыВыпуска.ТекущаяСтраница = Элементы.ГруппаСтраницаПечать;
	Если Не ЭтоОткрытиеИзРМОператора Тогда 
		
		ЭтаФорма.КоманднаяПанель.Видимость = Истина;
		//Элементы.ГруппаСтраницыВыпуска.ТекущаяСтраница = Элементы.ГруппаСтраницаПечать;
		АвтоЗаголовок = Истина;
		Элементы.Группа1.Видимость = Ложь;
		
		Если ВыводитьЗаголовки Тогда 
			Элементы.ГруппаСтраницыВыпуска.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
		КонецЕсли;
		
	Иначе
		ОтразитьВыпуск("");
		ОбновитьЭлементыНаФорме();
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыНаФорме()
	
	Элементы.ДекорацияКоличество.Заголовок = СтрШаблон("По плану: %1 / выпущено: %2", Формат(КоличествоПлан, "ЧДЦ=3; ЧГ=3,0"), Формат(КоличествоВыпущено, "ЧДЦ=3; ЧН=0; ЧГ=3,0"));
	
КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_ИТМ_ВыпускПродукцииОператором", Объект.Ссылка);
	
	
	//Элементы.ГруппаСтраницыВыпуска.ТекущаяСтраница = Элементы.ГруппаСтраницаПечать;
	
	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);
	
	ОбщегоНазначенияУТКлиент.ВыполнитьДействияПослеЗаписи(ЭтаФорма, Объект, ПараметрыЗаписи);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти



