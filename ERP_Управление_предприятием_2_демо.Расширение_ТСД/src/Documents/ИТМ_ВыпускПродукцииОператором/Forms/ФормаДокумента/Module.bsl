#Область ПрограммынйИнтерфейс

&НаСервере
Процедура ЗаполнитьУпаковку()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗШтрихкоды.Номенклатура КАК Номенклатура,
	|	ТЗШтрихкоды.Характеристика КАК Характеристика,
	|	ТЗШтрихкоды.Упаковка КАК Упаковка,
	|	ТЗШтрихкоды.Штрихкод КАК Штрихкод
	|ПОМЕСТИТЬ Вт_Штрихкоды
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ТЗШтрихкоды
	|ГДЕ
	|	ТЗШтрихкоды.Номенклатура = &Номенклатура
	|	И ТЗШтрихкоды.Характеристика = &Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Вт_Штрихкоды.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	Вт_Штрихкоды.Характеристика КАК Характеристика,
	|	Вт_Штрихкоды.Упаковка КАК Упаковка,
	|	Вт_Штрихкоды.Штрихкод КАК Штрихкод
	|ПОМЕСТИТЬ Вт_ШтрихкодыНеЗаполненные
	|ИЗ
	|	Вт_Штрихкоды КАК Вт_Штрихкоды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт_ШтрихкодыНеЗаполненные.Номенклатура КАК Номенклатура,
	|	Вт_ШтрихкодыНеЗаполненные.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Ссылка, Вт_ШтрихкодыНеЗаполненные.Упаковка)) КАК Упаковка,
	|	МАКСИМУМ(ЕСТЬNULL(УпаковкиЕдиницыИзмеренияПаллета.Ссылка, ЗНАЧЕНИЕ(СПРАВОЧНИК.УпаковкиЕдиницыИзмерения.ПустаяСсылка))) КАК Паллета,
	|	Вт_ШтрихкодыНеЗаполненные.Штрихкод КАК Штрихкод,
	|	СУММА(1) КАК Дубли
	|ПОМЕСТИТЬ Вт_ШтрикодыЗаполненныеУпак
	|ИЗ
	|	Вт_ШтрихкодыНеЗаполненные КАК Вт_ШтрихкодыНеЗаполненные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ПО (ВЫБОР
	|				КОГДА Вт_ШтрихкодыНеЗаполненные.Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры)
	|					ТОГДА Вт_ШтрихкодыНеЗаполненные.Номенклатура = УпаковкиЕдиницыИзмерения.Владелец
	|				ИНАЧЕ Вт_ШтрихкодыНеЗаполненные.Номенклатура.НаборУпаковок = УпаковкиЕдиницыИзмерения.Владелец
	|			КОНЕЦ)
	|			И (УпаковкиЕдиницыИзмерения.Ссылка.ЕдиницаИзмерения <> &Паллета)
	|			И (НЕ УпаковкиЕдиницыИзмерения.Ссылка.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмеренияПаллета
	|		ПО (ВЫБОР
	|				КОГДА Вт_ШтрихкодыНеЗаполненные.Номенклатура.НаборУпаковок = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.ИндивидуальныйДляНоменклатуры)
	|					ТОГДА Вт_ШтрихкодыНеЗаполненные.Номенклатура = УпаковкиЕдиницыИзмеренияПаллета.Владелец
	|				ИНАЧЕ Вт_ШтрихкодыНеЗаполненные.Номенклатура.НаборУпаковок = УпаковкиЕдиницыИзмеренияПаллета.Владелец
	|			КОНЕЦ)
	|			И (УпаковкиЕдиницыИзмеренияПаллета.Ссылка.ЕдиницаИзмерения = &Паллета)
	|			И (НЕ УпаковкиЕдиницыИзмеренияПаллета.Ссылка.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	Вт_ШтрихкодыНеЗаполненные.Номенклатура,
	|	Вт_ШтрихкодыНеЗаполненные.Характеристика,
	|	Вт_ШтрихкодыНеЗаполненные.Штрихкод
	|
	|ИМЕЮЩИЕ
	|	СУММА(1) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт_ШтрикодыЗаполненныеУпак.Номенклатура КАК Номенклатура,
	|	Вт_ШтрикодыЗаполненныеУпак.Характеристика КАК Характеристика,
	|	Вт_ШтрикодыЗаполненныеУпак.Упаковка КАК Упаковка,
	|	МАКСИМУМ(ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, """")) КАК Штрихкод,
	|	СУММА(1) КАК Дубли
	|ПОМЕСТИТЬ Вт_ШтрихкодыЗаполненныеШтрихкоды
	|ИЗ
	|	Вт_ШтрикодыЗаполненныеУпак КАК Вт_ШтрикодыЗаполненныеУпак
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ПО Вт_ШтрикодыЗаполненныеУпак.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|			И Вт_ШтрикодыЗаполненныеУпак.Характеристика = ШтрихкодыНоменклатуры.Характеристика
	|			И Вт_ШтрикодыЗаполненныеУпак.Упаковка = ШтрихкодыНоменклатуры.Упаковка
	|
	|СГРУППИРОВАТЬ ПО
	|	Вт_ШтрикодыЗаполненныеУпак.Номенклатура,
	|	Вт_ШтрикодыЗаполненныеУпак.Характеристика,
	|	Вт_ШтрикодыЗаполненныеУпак.Упаковка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Вт_ШтрикодыЗаполненныеУпак.Номенклатура КАК Номенклатура,
	|	Вт_ШтрикодыЗаполненныеУпак.Характеристика КАК Характеристика,
	|	Вт_ШтрикодыЗаполненныеУпак.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА Вт_ШтрикодыЗаполненныеУпак.Паллета.Родитель = Вт_ШтрикодыЗаполненныеУпак.Упаковка
	|			ТОГДА Вт_ШтрикодыЗаполненныеУпак.Паллета
	|		ИНАЧЕ ЗНАЧЕНИЕ(СПРАВОЧНИК.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК Паллета,
	|	ЕСТЬNULL(Вт_ШтрихкодыЗаполненныеШтрихкоды.Штрихкод, """") КАК Штрихкод
	|ИЗ
	|	Вт_ШтрикодыЗаполненныеУпак КАК Вт_ШтрикодыЗаполненныеУпак
	|		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ШтрихкодыЗаполненныеШтрихкоды КАК Вт_ШтрихкодыЗаполненныеШтрихкоды
	|		ПО Вт_ШтрикодыЗаполненныеУпак.Номенклатура = Вт_ШтрихкодыЗаполненныеШтрихкоды.Номенклатура
	|			И Вт_ШтрикодыЗаполненныеУпак.Характеристика = Вт_ШтрихкодыЗаполненныеШтрихкоды.Характеристика
	|			И Вт_ШтрикодыЗаполненныеУпак.Упаковка = Вт_ШтрихкодыЗаполненныеШтрихкоды.Упаковка";
	
	Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Объект.Характеристика);
	Запрос.УстановитьПараметр("Паллета", Объект.ЕдИзмПаллета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Объект.Упаковка = Выборка.Упаковка;
		Объект.ШтрихкодНоменклатуры = Выборка.Штрихкод;
	КонецЦикла;
	
	
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ОтразитьВыпуск(Команда)
	Объект.Дата = ТекущаяДата();
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	Элементы.ГруппаСтраницыВыпуска.ТекущаяСтраница = Элементы.ГруппаСтраницаПечать;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьМаркировочногоЯрлыка(Команда)
	
	
	КоллекцияПечатныхФорм = Новый Массив;
	
	Отказ = Ложь;
	
	ПечатьНаСервере(КоллекцияПечатныхФорм, Отказ);
	
	СписокСсылок = Новый СписокЗначений;
	СписокСсылок.Добавить(Объект.Ссылка);
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	#Если Не МобильныйКлиент И не ВебКлиент Тогда
		УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, СписокСсылок);
	#КонецЕсли
	
	#Если МобильныйКлиент или ВебКлиент Тогда
		ТабличныеДокументы = ТабличныеДокументыДляПечати(КоллекцияПечатныхФорм);
		//УправлениеПечатьюКлиент.РаспечататьТабличныеДокументы(ТабличныеДокументы, СписокСсылок);
		Для каждого ТабличныйДокумент Из ТабличныеДокументы Цикл 
			
			ИмяФайла=ПолучитьИмяВременногоФайла("pdf");
			ТабличныйДокумент.Значение.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
			ЗапуститьПриложение(ИмяФайла);
		КонецЦикла;
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция ТабличныеДокументыДляПечати(КоллекцияПечатныхФорм)
	ТабличныеДокументы = Новый СписокЗначений;
	Для Каждого НастройкаПечатнойФормы Из КоллекцияПечатныхФорм Цикл
		ПечатнаяФорма = НастройкаПечатнойФормы.ТабличныйДокумент;
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Вывести(ПечатнаяФорма);
		УправлениеПечатью.СкопироватьСвойстваТабличногоДокумента(ТабличныйДокумент, ПечатнаяФорма);
		ТабличныйДокумент.КоличествоЭкземпляров = 1;
		ТабличныеДокументы.Добавить(ТабличныйДокумент, НастройкаПечатнойФормы.СинонимМакета);
	КонецЦикла;
	
	Возврат ТабличныеДокументы;
КонецФункции

&НаСервере
Процедура ПечатьНаСервере(КоллекцияПечатныхФорм, Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм("ПФ_MXL_МаркировочныйЯрлык_ГП");
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(ОБъект.Ссылка);
	Документы.ИТМ_ВыпускПродукцииОператором.ПечатьМЯ(МассивДокументов, КоллекцияПечатныхФорм); 
	
	КоллекцияПечатныхФорм = ОбщегоНазначения.ТаблицаЗначенийВМассив(КоллекцияПечатныхФорм);
	
	Индекс = 0;
	Пока Индекс <= КоллекцияПечатныхФорм.Количество() - 1 Цикл
		Если ТипЗнч(КоллекцияПечатныхФорм[Индекс]) = Тип("Структура") Тогда
			Если КоллекцияПечатныхФорм[Индекс].Свойство("ДоступенВыводНаДругихЯзыках") = Ложь Тогда
				КоллекцияПечатныхФорм[Индекс].Вставить("ДоступенВыводНаДругихЯзыках", Ложь);
			КонецЕсли;
			КоллекцияПечатныхФорм[Индекс].Вставить("ДвусторонняяПечать", Ложь);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
КонецПроцедуры


